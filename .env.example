# Review Gateway -- environment variables. Key names only, no real values.
# Gateway-only, post worker-repo-split (docs/worker-gateway-split-architecture.md §7.1). Worker-only
# keys (GATEWAY_URL, GATEWAY_API_KEY, WORKER_ID, BACKEND_ID, LLAMA_URL, LLAMA_MAX_TOKENS, ...) live in
# each Worker host's own .env in the AIReviewWorker repo -- see worker/.env.example (via the
# submodule) and DEPLOYMENT.md's cross-repo coupling table.

# --- Bearer tokens ---
DB_PASSWORD=
CI_TOKEN=
# WORKER_TOKEN's value must equal every Worker's GATEWAY_API_KEY (see worker/.env.example).
WORKER_TOKEN=
ADMIN_TOKEN=

# --- GitLab ---
GITLAB_TOKEN=
GITLAB_BASE_URL=

# --- Backend registration / health probe ---
BACKEND_ALLOWED_HOST_PATTERN=
LLAMA_MODEL=
LLAMA_URL_1=
LLAMA_URL_2=

# --- Prompt Manager (V3, optional) ---
PROMPT_MANAGER_ENABLED=
GITLAB_PROMPT_TOKEN=
PROMPT_CORPORATE_PROJECT=
PROMPT_CORPORATE_REF=
PROMPT_CORPORATE_BASE_PROMPT_PATH=
PROMPT_CORPORATE_REVIEW_RULES_PATH=
PROMPT_ON_ERROR=

# --- Structured Review Output (V5) ---
ALLOWED_PROMPT_VERSIONS=
STRUCTURED_OUTPUT_ENABLED=
STRUCTURED_OUTPUT_DEFAULT_MODE=
